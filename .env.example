ENVIRONMENT=development
DATABASE_URL=sqlite:///./data/vault.db
MASTER_KEY=GENERATE_WITH_SETUP_SCRIPT
PREVIOUS_MASTER_KEYS=
FRONTEND_URL=http://localhost:3000
ALLOWED_HOSTS=localhost,127.0.0.1,testserver
COOKIE_SECURE=false
STORAGE_BACKEND=local
STORAGE_PATH=data/objects
MAX_STORAGE_BYTES=104857600
MAX_UPLOAD_BYTES=26214400
TRASH_DAYS=30
EMAIL_PROVIDER=console
EMAIL_FROM=vault@localhost
# For S3 use STORAGE_BACKEND=s3 and the normal AWS credential chain.
S3_BUCKET_NAME=
AWS_REGION=eu-north-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# S3_ENDPOINT_URL=
# SMTP is required in production.
SMTP_HOST=
SMTP_PORT=587
SMTP_TLS=true
SMTP_SSL=false
SMTP_USERNAME=
SMTP_PASSWORD=
# Docker development database password.
POSTGRES_PASSWORD=GENERATE_STORAGE_PASSWORD
